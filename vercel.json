{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/technical.js": {
      "regions": [
        "sin1"
      ],
      "maxDuration": 60
    },
    "api/fundflow.js": {
      "regions": [
        "sin1"
      ],
      "maxDuration": 60
    },
    "api/sync-status.js": {
      "regions": [
        "sin1"
      ],
      "maxDuration": 60
    },
    "api/market-dynamic-refresh.js": {
      "regions": [
        "sin1"
      ],
      "maxDuration": 60
    },
    "api/market-dynamic.js": {
      "regions": [
        "sin1"
      ],
      "maxDuration": 60
    },
    "api/capital-flow.js": {
      "regions": [
        "sin1"
      ],
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync-status",
      "schedule": "0 7 * * 1-5"
    },
    {
      "path": "/api/sync-status",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/sync-status",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/market-dynamic-refresh",
      "schedule": "50 14 * * 1-5"
    },
    {
      "path": "/api/market-dynamic-refresh",
      "schedule": "35 15 * * 1-5"
    },
    {
      "path": "/api/capital-flow",
      "schedule": "8 8 * * 1-5"
    },
    {
      "path": "/api/fundflow?view=industry-changes&action=scan",
      "schedule": "30 9 * * 1-5"
    },
    {
      "path": "/api/market-dynamic-refresh?paper=stage3",
      "schedule": "15 22 * * 1-5"
    },
    {
      "path": "/api/sync-status",
      "schedule": "20 10 * * 1-5"
    },
    {
      "path": "/api/sync-status",
      "schedule": "50 10 * * 1-5"
    },
    {
      "path": "/api/market-dynamic-refresh",
      "schedule": "20 11 * * 1-5"
    },
    {
      "path": "/api/market-dynamic-refresh",
      "schedule": "40 12 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/stock",
      "destination": "/api/quote?sz_route=stock"
    },
    {
      "source": "/api/dw4",
      "destination": "/api/fundflow?sz_route=dw4"
    },
    {
      "source": "/api/w3-d111-shadow",
      "destination": "/api/market-dynamic?sz_shadow=d111"
    },
    {
      "source": "/api/w3-d112-shadow",
      "destination": "/api/market-dynamic?sz_shadow=d112"
    }
  ]
}
